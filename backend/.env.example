# Copy this file to .env and fill in your values
# When running via docker-compose, use the service name "postgres" as the host

DATABASE_URL=postgresql://myt_user:myt_password@postgres:5432/myt_clone
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
PORT=3000
NODE_ENV=development

# PostgreSQL credentials (used by docker-compose for the postgres service)
POSTGRES_USER=myt_user
POSTGRES_PASSWORD=myt_password
POSTGRES_DB=myt_clone
